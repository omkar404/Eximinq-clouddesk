# Leave blank to use the same hostname as the browser with API port 4001.
VITE_API_URL=
PORT=4001
# Local development database only. Keep the real password in your ignored .env file.
NODE_ENV=development
DATABASE_URL=postgresql://clouddesk_app:change-me@localhost:5432/eximinq_clouddesk_app
# auto enables verified TLS for Neon/production and disables TLS for localhost.
DATABASE_SSL=auto
DATABASE_POOL_MAX=10
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://YOUR_LAN_IP:5173
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@eximinq.com
ADMIN_PASSWORD=replace-with-a-strong-password
CLIENT_EMAIL=client@example.com
CLIENT_PASSWORD=replace-with-a-strong-password
